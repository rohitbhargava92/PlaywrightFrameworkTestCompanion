{
  "name": "saucedemo-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript POM framework for saucedemo.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:chromium": "npx playwright test --project=chromium",
    "report": "npx playwright show-report",
    "allure:report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "postinstall": "npm update browserstack-node-sdk",
    "test-browserstack": "npx browserstack-node-sdk playwright test",
    "test:smoke-browserstack": "npx browserstack-node-sdk playwright test --grep @smoke",
    "test:headed-browserstack": "npx browserstack-node-sdk playwright test --headed",
    "test:ui-browserstack": "npx browserstack-node-sdk playwright test --ui",
    "test:chromium-browserstack": "npx browserstack-node-sdk playwright test --project=chromium",
    "report-browserstack": "npx browserstack-node-sdk playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "browserstack-node-sdk": "^1.72.2",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.5"
  }
}